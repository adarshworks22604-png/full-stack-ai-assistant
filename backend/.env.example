# Names only. Never commit real values. Copy to backend/.env for local work.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=https://localhost:3000

# --- Authentication ---
# Local only. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_MODE=dev
DEV_JWT_SECRET=
# Production (AUTH_MODE=entra): Microsoft Entra ID
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
# Optional issuer override. Default is https://login.microsoftonline.com/<tenant>/v2.0
ENTRA_ISSUER=
# JSON map of Entra group ID -> products, e.g. {"<group-id>": ["payments"]}
ENTRA_GROUP_PRODUCT_MAP={}

# --- Limits ---
MAX_REQUEST_BODY_BYTES=65536
REQUEST_TIMEOUT_SECONDS=60
SSE_HEARTBEAT_SECONDS=15
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_STREAMS_GLOBAL=50
MAX_CONCURRENT_STREAMS_PER_USER=2

# --- Integrations ---
USE_MOCK_INTEGRATIONS=true
MOCK_STEP_DELAY_SECONDS=0.3
BUG_ID_PATTERN=\bBUG-\d{1,8}\b
BUG_API_BASE_URL=
BUG_API_TOKEN=
DOCS_API_BASE_URL=
DOCS_API_TOKEN=
UPSTREAM_CONNECT_TIMEOUT=3
UPSTREAM_READ_TIMEOUT=8
UPSTREAM_WRITE_TIMEOUT=5
UPSTREAM_POOL_TIMEOUT=3
UPSTREAM_MAX_RETRIES=2
UPSTREAM_BACKOFF_BASE_SECONDS=0.2
UPSTREAM_BACKOFF_MAX_SECONDS=2
UPSTREAM_MAX_CONCURRENCY=10
UPSTREAM_MAX_RESPONSE_BYTES=1000000

# --- Later stages (not used yet) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
DATABASE_URL=
